{
  "name": "Airflow Practice",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Airflow UI" }
  },
  "postCreateCommand": "cd airflow && docker compose up -d"
}
